# Copy to .env.docker before running docker-compose.windows.yml.

# Windows Docker Desktop on x64 should use linux/amd64.
NORI_DOCKER_PLATFORM=linux/amd64

# Base image used by Dockerfile. Keep official Node unless Docker Hub is blocked.
NORI_NODE_IMAGE=node:22-bookworm-slim

# Public browser URL on the Windows host.
NEXTAUTH_URL=http://localhost:13000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Internal service-to-service URL inside Docker.
INTERNAL_APP_URL=http://web:3000

# Keep this 32+ chars. Changing it later can make stored provider keys unreadable.
API_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
CRON_SECRET=replace-with-a-long-random-cron-secret
INTERNAL_TASK_TOKEN=replace-with-a-long-random-task-token

# Database and Redis passwords used by docker-compose.windows.yml.
MYSQL_ROOT_PASSWORD=nori123
MYSQL_DATABASE=nori

# Storage:
# minio is easiest for local Windows deployment.
# Use tos for real image/video providers that must fetch public image URLs.
NORI_STORAGE_TYPE=minio
MINIO_ACCESS_KEY=noriadmin
MINIO_SECRET_KEY=noriadmin123
MINIO_BUCKET=nori
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true

# TOS storage, required when NORI_STORAGE_TYPE=tos.
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_PUBLIC_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=

# Optional Volcengine MediaKit video enhancement key.
VOLCENGINE_MEDIAKIT_API_KEY=

# Worker concurrency. Keep moderate on Windows Docker Desktop.
QUEUE_CONCURRENCY_IMAGE=8
QUEUE_CONCURRENCY_VIDEO=4
QUEUE_CONCURRENCY_VOICE=4
QUEUE_CONCURRENCY_TEXT=8

# Bull Board basic auth. Empty means no auth.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

LOG_LEVEL=INFO
BILLING_MODE=OFF
