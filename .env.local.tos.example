# 火山引擎 TOS / S3 兼容存储配置
# 使用方式：确认 Bucket 地域和 AK/SK 后，将本段复制到 .env.local，并重启 Next 服务。
# 注意：MINIO_ACCESS_KEY / MINIO_SECRET_KEY 是火山引擎访问控制的 AccessKeyId / SecretAccessKey，
# 不是 MediaKit API Key。

STORAGE_TYPE=tos

# 华北2（北京）TOS 原生 endpoint；如果 Bucket 不在北京，请替换成对应地域 endpoint。
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_PUBLIC_ENDPOINT=https://tos-cn-beijing.volces.com

TOS_BUCKET=chaofen
TOS_ACCESS_KEY=你的AccessKeyId
TOS_SECRET_KEY=你的SecretAccessKey
TOS_REGION=cn-beijing