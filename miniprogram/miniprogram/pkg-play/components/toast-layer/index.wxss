.toast-layer {
  position: absolute; inset: 0; z-index: 60;
  display: flex; justify-content: center; align-items: flex-start;
  padding-top: 200rpx; pointer-events: none;
}
.toast {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 20rpx 32rpx; border-radius: var(--radius-card);
  background: var(--surface-2); border: 2rpx solid var(--ending-hidden);
  animation: toast-in 200ms ease-out;
}
.toast-title { color: var(--text); font-size: var(--font-body); font-weight: 600; }
.toast-reward { color: var(--ending-hidden); font-size: var(--font-aux); }
@keyframes toast-in {
  from { opacity: 0; transform: translateY(-16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
