.ix-swipe {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.guide {
  position: absolute;
  top: 24rpx;
  color: var(--brand);
  font-size: 56rpx;
  opacity: 0.8;
}
.guide.is-up { transform: rotate(-90deg); }
.guide.is-down { transform: rotate(90deg); }
.guide.is-left { transform: rotate(180deg); }
.guide.is-right { transform: rotate(0deg); }
.btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  border: 4rpx solid var(--brand);
}
.btn-img {
  position: absolute;
  width: 200rpx;
  height: 200rpx;
}
.btn-label {
  position: relative;
  color: var(--text);
  font-size: var(--font-body);
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}
.tip {
  position: absolute;
  bottom: 0;
  color: var(--text-2);
  font-size: var(--font-aux);
}