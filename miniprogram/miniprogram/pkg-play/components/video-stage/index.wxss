.stage {
  position: absolute;
  inset: 0;
  background: #000;
  overflow: hidden;
  pointer-events: auto;
}
.slot {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  z-index: 1;
}
.slot.is-active {
  opacity: 1;
  z-index: 2;
}
.last-frame {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
}
.image-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 4;
  transition: opacity 200ms ease;
}
.loading {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--text-2);
  font-size: var(--font-aux);
  background: rgba(0, 0, 0, 0.35);
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 800ms linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.media-error {
  position: absolute;
  inset: 0;
  z-index: 6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  background: rgba(0, 0, 0, 0.72);
}
.media-error-title {
  color: var(--text);
  font-size: var(--font-body);
}
.media-error-actions {
  display: flex;
  gap: 24rpx;
}
.btn {
  margin: 0;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-button);
  background: var(--brand);
  color: #fff;
  font-size: var(--font-body);
}
.btn.is-ghost {
  background: var(--surface-2);
  color: var(--text);
}