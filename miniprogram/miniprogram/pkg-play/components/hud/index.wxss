.hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 120rpx 24rpx 0;
  pointer-events: none;
}
.back {
  pointer-events: auto;
  margin: 0;
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 48rpx;
}
.vars {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
}
.chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: var(--text);
  font-size: var(--font-aux);
}
.chip-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
}
.chip-emoji {
  font-size: 28rpx;
}
.chip-value {
  font-weight: 600;
}
.actions {
  pointer-events: auto;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-end;
}
.action {
  margin: 0;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: var(--text);
  font-size: var(--font-aux);
}