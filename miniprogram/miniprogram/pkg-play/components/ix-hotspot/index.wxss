.ix-hotspot {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.zones {
  position: absolute;
}
.zone {
  position: absolute;
  border-radius: var(--radius-tag);
  opacity: 0;
}
.zones.is-visible .zone {
  opacity: 1;
  border: 2rpx dashed rgba(255, 255, 255, 0.7);
  background: rgba(76, 125, 255, 0.18);
}