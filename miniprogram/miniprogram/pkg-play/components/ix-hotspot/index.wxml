<view class="ix-hotspot" wx:if="{{interaction && box}}">
  <view
    class="zones {{interaction.spec.showZones ? 'is-visible' : ''}}"
    style="left:{{box.left}}px;top:{{box.top}}px;width:{{box.width}}px;height:{{box.height}}px"
  >
    <view
      wx:for="{{interaction.spec.zones}}"
      wx:key="id"
      class="zone"
      style="left:{{item.x * 100}}%;top:{{item.y * 100}}%;width:{{item.w * 100}}%;height:{{item.h * 100}}%"
    />
  </view>
</view>