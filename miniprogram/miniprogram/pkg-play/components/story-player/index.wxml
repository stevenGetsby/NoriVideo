<view class="player stage-wrap is-{{orientation}}">
  <video-stage
    id="stage"
    imageOverlay="{{imageOverlay || ''}}"
    mediaError="{{mediaError}}"
    loading="{{loading}}"
    bind:timeupdate="onVideoTime"
    bind:ended="onVideoEnded"
    bind:waiting="onVideoWaiting"
    bind:playing="onVideoPlaying"
    bind:error="onVideoError"
    bind:retry="onVideoRetry"
    bind:skip="onVideoSkip"
  />
  <scene-text scene="{{scene}}" bind:continue="onSceneContinue" />
  <interaction-layer
    interaction="{{interaction}}"
    mediaW="{{mediaW}}"
    mediaH="{{mediaH}}"
    orientation="{{orientation}}"
    lockedHint="{{lockedHint}}"
    stageRect="{{stageRect}}"
    bind:pointerdown="onPointerDown"
    bind:pointermove="onPointerMove"
    bind:pointerup="onPointerUp"
    bind:choose="onChoose"
  />
  <view class="choice-capsule" wx:if="{{choiceCapsule}}">{{choiceCapsule}}</view>
  <choice-panel
    wx:if="{{choice}}"
    prompt="{{choice.prompt}}"
    options="{{choice.options}}"
    panelStyle="{{choice.panelStyle}}"
    layout="{{choice.layout}}"
    orientation="{{orientation}}"
    countdownPercent="{{choice.countdownPercent === null ? -1 : choice.countdownPercent}}"
    durationSec="{{choice.timeoutSec || 0}}"
    lockedHint="{{lockedHint}}"
    bind:choose="onChoose"
  />
  <hud
    hud="{{hud}}"
    orientation="{{orientation}}"
    bind:back="onBack"
    bind:speed="onSpeed"
    bind:saves="onOpenMap"
    bind:shop="onOpenShop"
    bind:achievements="onOpenAchievements"
  />
  <shop-sheet
    wx:if="{{sheet === 'shop'}}"
    shop="{{shop}}"
    orientation="{{orientation}}"
    bind:buy="onBuy"
    bind:close="onCloseSheet"
  />
  <saves-sheet
    wx:if="{{sheet === 'saves'}}"
    saves="{{savesSheet}}"
    orientation="{{orientation}}"
    bind:resume="onResumeAuto"
    bind:save="onSaveSlot"
    bind:load="onLoadSlot"
    bind:delete="onDeleteSlot"
    bind:checkpoint="onCheckpoint"
    bind:close="onCloseSheet"
  />
  <map-sheet
    wx:if="{{sheet === 'map'}}"
    mapSheet="{{mapSheet}}"
    orientation="{{orientation}}"
    bind:checkpoint="onCheckpoint"
    bind:resume="onResumeAuto"
    bind:save="onSaveSlot"
    bind:load="onLoadSlot"
    bind:delete="onDeleteSlot"
    bind:close="onCloseSheet"
  />
  <achievement-sheet
    wx:if="{{sheet === 'achievements'}}"
    achievements="{{achievementsSheet}}"
    orientation="{{orientation}}"
    bind:equip="onEquip"
    bind:close="onCloseSheet"
  />
  <ending-card
    wx:if="{{ending && !sheet}}"
    ending="{{ending}}"
    orientation="{{orientation}}"
    bind:restart="onRestart"
    bind:saves="onOpenSaves"
    bind:back="onBack"
    bind:poster="onEndingPoster"
  />
  <view class="card" wx:if="{{card && !sheet}}">
    <text class="card-kicker">{{card.kicker}}</text>
    <text class="card-title">{{card.title}}</text>
    <text class="card-desc" wx:if="{{card.kind === 'exit'}}">全剧试玩时会从这里进入下一章。</text>
    <view class="actions">
      <button class="btn is-primary" bindtap="onRestart">再玩一次</button>
      <button class="btn" bindtap="onBack">返回详情</button>
    </view>
  </view>
  <continue-prompt promptMode="{{promptMode}}" prompt="{{prompt}}" bind:resume="onPromptResume" bind:restart="onRestart" />
  <view class="notice" wx:if="{{continueNotice}}">{{continueNotice}}</view>
  <toast-layer toast="{{toast}}" />
  <text class="aigc">{{aigc}}</text>
  <view class="boot" wx:if="{{!ready}}">
    <view class="boot-error" wx:if="{{error}}">
      <text>{{error}}</text>
      <view class="actions">
        <button class="btn is-primary" bindtap="onRetryBoot">重试</button>
        <button class="btn" bindtap="onExitBack">返回</button>
      </view>
    </view>
    <view class="boot-loading" wx:else>
      <view class="spinner" />
      <text>加载中</text>
    </view>
  </view>
</view>
