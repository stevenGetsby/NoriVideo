.player {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}
video-stage,
scene-text,
interaction-layer,
choice-panel,
hud,
shop-sheet,
saves-sheet,
map-sheet,
achievement-sheet,
ending-card,
toast-layer,
continue-prompt {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.card {
  position: absolute;
  inset: 0;
  z-index: 45;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 48rpx;
  background: rgba(14, 15, 26, 0.92);
  text-align: center;
}
.card-kicker { color: var(--text-2); font-size: var(--font-aux); }
.card-title { color: var(--text); font-size: var(--font-card-title); font-weight: 600; }
.card-desc { color: var(--text-2); font-size: var(--font-body); line-height: 1.6; }
.actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 20rpx; margin-top: 16rpx; }
.btn {
  margin: 0; padding: 0 32rpx; height: 72rpx; line-height: 72rpx;
  border-radius: var(--radius-button); background: var(--surface-2);
  color: var(--text); font-size: var(--font-body);
}
.btn.is-primary { background: var(--brand); color: #fff; }
.notice {
  position: absolute;
  top: 180rpx; left: 50%;
  transform: translateX(-50%);
  z-index: 55;
  max-width: 80%;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
  pointer-events: none;
}
.choice-capsule {
  position: absolute;
  top: 180rpx; left: 50%;
  transform: translateX(-50%);
  z-index: 56;
  max-width: 80%;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
  pointer-events: none;
  animation: capsule-fade 2.5s ease forwards;
}
@keyframes capsule-fade {
  0% { opacity: 0; }
  12% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}
.aigc {
  position: absolute;
  left: 24rpx; bottom: 24rpx;
  z-index: 70;
  color: #fff;
  opacity: 0.6;
  font-size: 24rpx;
  pointer-events: none;
}
.boot {
  position: absolute;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg);
}
.boot-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  color: var(--text-2);
  font-size: var(--font-aux);
}
.boot-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 48rpx;
  color: var(--text-2);
  font-size: var(--font-body);
  text-align: center;
}
.spinner {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid var(--surface-2);
  border-top-color: var(--brand);
  animation: spin 800ms linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
