.ix-hold {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}
.btn {
  position: relative;
  width: 220rpx;
  height: 320rpx;
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--surface-2);
  border: 4rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.band {
  position: absolute;
  left: 0;
  width: 100%;
  background: rgba(56, 211, 159, 0.28);
  border-top: 2rpx solid var(--ending-good);
  border-bottom: 2rpx solid var(--ending-good);
}
.fill {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(0deg, var(--brand), #7b5cff);
  opacity: 0.7;
}
.btn-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.btn-label {
  position: relative;
  color: var(--text);
  font-size: var(--font-body);
  font-weight: 600;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}
.hint {
  color: var(--text-2);
  font-size: var(--font-aux);
}