<view class="ix-timing" wx:if="{{interaction}}">
  <view class="bar">
    <view class="zone is-normal" style="left:{{50 - interaction.spec.normalWidth / 2}}%;width:{{interaction.spec.normalWidth}}%" />
    <view class="zone is-perfect" style="left:{{50 - interaction.spec.perfectWidth / 2}}%;width:{{interaction.spec.perfectWidth}}%" />
    <view class="pointer" style="left:{{interaction.timingPosition * 100}}%">
      <image wx:if="{{interaction.spec.propImageUrl}}" class="prop" src="{{interaction.spec.propImageUrl}}" mode="aspectFill" />
    </view>
  </view>
  <text class="tip">当指针进入亮色区域时点击</text>
</view>