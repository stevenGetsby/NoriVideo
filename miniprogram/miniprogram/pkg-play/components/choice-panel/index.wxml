<view class="choice-panel is-{{orientation}} is-{{resolved}} {{textOnly ? 'is-text-only' : ''}}">
  <view class="countdown" wx:if="{{showCountdown}}">
    <view class="countdown-fill" style="width:{{countdownPercent}}%" />
    <text class="countdown-text">{{countdownLeft}}s</text>
  </view>
  <text class="lock-hint" wx:if="{{lockedHint}}">还没有解锁</text>
  <text class="prompt" wx:if="{{prompt}}">{{prompt}}</text>
  <view class="options">
    <button
      wx:for="{{views}}"
      wx:key="id"
      class="option {{item.showImage ? 'has-image' : ''}} {{item.locked ? 'is-locked' : ''}}"
      data-id="{{item.id}}"
      bindtap="onChoose"
    >
      <text class="lock" wx:if="{{item.locked}}">锁</text>
      <image wx:if="{{item.showImage}}" class="option-img" src="{{item.image}}" mode="aspectFill" />
      <text wx:if="{{item.showText}}" class="option-text">{{item.label}}</text>
    </button>
  </view>
</view>