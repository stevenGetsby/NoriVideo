<view class="sheet is-{{orientation}}" wx:if="{{mapSheet}}">
  <view class="backdrop" bindtap="onClose" />
  <view class="panel">
    <view class="head">
      <text class="title">地图与存档</text>
      <view class="tabs">
        <button class="tab {{tab === 'map' ? 'is-on' : ''}}" bindtap="onTabMap">地图</button>
        <button class="tab {{tab === 'saves' ? 'is-on' : ''}}" bindtap="onTabSaves">存档</button>
      </view>
      <button class="close" bindtap="onClose">×</button>
    </view>
    <text class="notice" wx:if="{{mapSheet.saves.notice}}">{{mapSheet.saves.notice}}</text>
    <scroll-view wx:if="{{tab === 'map'}}" scroll-x scroll-y class="map-body">
      <view wx:if="{{points.length === 0}}" class="empty">这部影游还没有设置存档点。</view>
      <view wx:else class="map" style="width:{{width}}rpx;height:{{height}}rpx">
        <view
          wx:for="{{routes}}"
          wx:key="key"
          class="route {{item.lit ? 'is-lit' : ''}}"
          style="left:{{item.x1}}rpx;top:{{item.y1}}rpx;width:{{item.length}}rpx;transform:rotate({{item.angle}}deg)"
        />
        <view
          wx:for="{{points}}"
          wx:key="key"
          class="point {{item.current ? 'is-current' : ''}} {{item.unlocked ? '' : 'is-locked'}}"
          style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{pointW}}rpx;min-height:{{pointH}}rpx"
        >
          <image wx:if="{{item.cover}}" class="point-cover" src="{{item.cover}}" mode="aspectFill" />
          <view wx:else class="point-cover is-text">{{item.unlocked ? '存' : '锁'}}</view>
          <text class="point-name">{{item.name || '保存点'}}</text>
          <text class="point-badge" wx:if="{{item.current}}">当前位置</text>
          <button class="point-btn" wx:if="{{item.canResume}}" data-key="{{item.key}}" bindtap="onCheckpoint">从这里继续</button>
        </view>
      </view>
    </scroll-view>
    <view class="saves-wrap" wx:if="{{tab === 'saves'}}">
      <saves-sheet
        embedded="{{true}}"
        saves="{{mapSheet.saves}}"
        orientation="{{orientation}}"
        bind:resume="onResume"
        bind:save="onSave"
        bind:load="onLoad"
        bind:delete="onDelete"
        bind:checkpoint="onCheckpoint"
      />
    </view>
  </view>
</view>
