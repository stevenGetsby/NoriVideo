.sheet { position: absolute; inset: 0; z-index: 40; pointer-events: auto; }
.backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6); }
.panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 82%;
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
}
.is-landscape .panel {
  left: 50%; right: auto; bottom: 50%;
  transform: translate(-50%, 50%);
  width: 960rpx; max-height: 90%;
  border-radius: 24rpx;
}
.head { display: flex; align-items: center; gap: 16rpx; }
.title { color: var(--text); font-size: var(--font-card-title); font-weight: 600; flex-shrink: 0; }
.tabs { flex: 1; display: flex; gap: 12rpx; }
.tab {
  margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx;
  border-radius: var(--radius-button); background: var(--surface-2);
  color: var(--text-2); font-size: var(--font-aux);
}
.tab.is-on { background: var(--brand); color: #fff; }
.close {
  margin: 0; padding: 0; width: 56rpx; height: 56rpx; line-height: 52rpx;
  border-radius: 50%; background: var(--surface-2); color: var(--text-2); font-size: 40rpx;
  flex-shrink: 0;
}
.notice { color: var(--ending-good); font-size: var(--font-aux); margin-top: 12rpx; }
.map-body { flex: 1; min-height: 0; margin-top: 24rpx; }
.empty { color: var(--text-3); font-size: var(--font-aux); padding: 48rpx 0; text-align: center; }
.map { position: relative; }
.route {
  position: absolute; height: 4rpx; border-radius: 2rpx;
  background: var(--surface-2); transform-origin: 0 50%;
}
.route.is-lit { background: var(--brand); }
.point {
  position: absolute; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  padding: 12rpx; border-radius: var(--radius-card); background: var(--surface-2);
}
.point.is-current { border: 2rpx solid var(--brand); }
.point.is-locked { opacity: 0.5; }
.point-cover { width: 100%; height: 120rpx; border-radius: 8rpx; background: var(--surface); }
.point-cover.is-text {
  display: flex; align-items: center; justify-content: center;
  color: var(--text-3); font-size: 40rpx;
}
.point-name { color: var(--text); font-size: var(--font-aux); text-align: center; }
.point-badge { color: var(--brand); font-size: 22rpx; }
.point-btn {
  margin: 0; padding: 0 16rpx; height: 48rpx; line-height: 48rpx;
  border-radius: var(--radius-button); background: var(--brand); color: #fff; font-size: 22rpx;
}
.saves-wrap { flex: 1; min-height: 0; display: flex; flex-direction: column; margin-top: 24rpx; }
.saves-wrap saves-sheet { flex: 1; min-height: 0; display: flex; flex-direction: column; }
