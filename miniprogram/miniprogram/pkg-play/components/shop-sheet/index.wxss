.sheet {
  position: absolute;
  inset: 0;
  z-index: 40;
  pointer-events: auto;
}
.backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
}
.panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 76%;
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: var(--surface);
}
.is-landscape .panel {
  left: 50%;
  right: auto;
  bottom: 50%;
  transform: translate(-50%, 50%);
  width: 720rpx;
  max-height: 86%;
  border-radius: 24rpx;
}
.head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.title {
  flex: 1;
  color: var(--text);
  font-size: var(--font-card-title);
  font-weight: 600;
}
.balance {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--ending-hidden);
  font-size: var(--font-body);
}
.balance-icon { width: 32rpx; height: 32rpx; border-radius: 50%; }
.balance-value { font-weight: 600; }
.close {
  margin: 0;
  padding: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: 40rpx;
}
.note { color: var(--text-3); font-size: var(--font-aux); margin-top: 12rpx; }
.error { color: var(--ending-bad); font-size: var(--font-aux); margin-top: 12rpx; }
.notice { color: var(--ending-good); font-size: var(--font-aux); margin-top: 12rpx; }
.empty { color: var(--text-3); font-size: var(--font-body); padding: 48rpx 0; text-align: center; }
.list { flex: 1; margin-top: 24rpx; max-height: 60vh; }
.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
  margin-bottom: 16rpx;
}
.item.is-focused { border: 2rpx solid var(--brand); }
.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-tag);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  flex-shrink: 0;
}
.icon-img { width: 100%; height: 100%; }
.icon-text { font-size: 40rpx; color: var(--text); }
.item-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.item-name { display: flex; align-items: center; gap: 12rpx; color: var(--text); font-size: var(--font-body); }
.item-owned { color: var(--ending-good); font-size: var(--font-aux); }
.item-desc { color: var(--text-2); font-size: var(--font-aux); }
.item-price { display: flex; align-items: center; gap: 8rpx; color: var(--ending-hidden); font-size: var(--font-aux); }
.price-unit { color: var(--text-3); }
.buy {
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-button);
  background: var(--brand);
  color: #fff;
  font-size: var(--font-aux);
  flex-shrink: 0;
}
.buy.is-disabled { background: var(--surface); color: var(--text-3); }