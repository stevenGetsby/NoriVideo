.ix-tap {
  position: relative;
  width: 240rpx;
  height: 280rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ring {
  position: absolute;
  top: 0;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
}
.ring-hole {
  position: absolute;
  inset: 12rpx;
  border-radius: 50%;
  background: rgba(14, 15, 26, 0.82);
}
.btn {
  position: absolute;
  top: 24rpx;
  width: 192rpx;
  height: 192rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
}
.btn-img {
  width: 100%;
  height: 100%;
}
.btn-label {
  color: var(--text);
  font-size: var(--font-card-title);
  font-weight: 600;
}
.count {
  position: absolute;
  bottom: 0;
  color: var(--text-2);
  font-size: var(--font-aux);
}