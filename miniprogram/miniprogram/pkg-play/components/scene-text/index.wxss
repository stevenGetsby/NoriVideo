.scene-text {
  position: absolute;
  inset: 0;
  z-index: 10;
  pointer-events: none;
}
.subtitle {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 96rpx;
  text-align: center;
  color: #fff;
  font-size: var(--font-body);
  line-height: 1.6;
  white-space: pre-wrap;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.8);
}
.pending {
  position: absolute;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.6);
  color: var(--text-2);
  font-size: var(--font-aux);
}
.continue {
  position: absolute;
  right: 32rpx;
  bottom: 32rpx;
  margin: 0;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: var(--font-body);
  pointer-events: auto;
}