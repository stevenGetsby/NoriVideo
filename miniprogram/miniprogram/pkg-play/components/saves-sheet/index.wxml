<view class="sheet is-{{orientation}} {{embedded ? 'is-embedded' : ''}}" wx:if="{{saves}}">
  <view class="backdrop" wx:if="{{!embedded}}" bindtap="onClose" />
  <view class="{{embedded ? 'embedded' : 'panel'}}">
    <view class="head" wx:if="{{!embedded}}">
      <text class="title">存档</text>
      <button class="close" bindtap="onClose">×</button>
    </view>
    <text class="notice" wx:if="{{saves.notice}}">{{saves.notice}}</text>
    <scroll-view scroll-y class="body">
      <view class="section">
        <text class="section-title">自动存档</text>
        <view class="slot">
          <view class="slot-info">
            <text class="slot-name">自动存档</text>
            <text class="slot-label">{{autoView.label}}</text>
            <text class="slot-time">{{autoView.timeText}}</text>
          </view>
          <button class="btn" disabled="{{!autoView.filled || !autoView.valid}}" bindtap="onResume">读取</button>
        </view>
      </view>
      <view class="section">
        <text class="section-title">手动存档</text>
        <view wx:for="{{slotViews}}" wx:key="index" class="slot">
          <view class="slot-info">
            <text class="slot-name">存档位 {{item.index + 1}}</text>
            <text class="slot-label {{item.filled && !item.valid ? 'is-stale' : ''}}">{{item.filled && !item.valid ? '此存档来自旧版本，无法继续' : item.label}}</text>
            <text class="slot-time">{{item.timeText}}</text>
          </view>
          <view class="slot-actions">
            <button class="btn is-primary" disabled="{{!saves.canSave}}" data-index="{{item.index}}" bindtap="onSave">存档</button>
            <button class="btn" disabled="{{!item.filled || !item.valid}}" data-index="{{item.index}}" bindtap="onLoad">读取</button>
            <button class="btn is-danger" disabled="{{!item.filled}}" data-index="{{item.index}}" bindtap="onDelete">删除</button>
          </view>
        </view>
      </view>
      <view class="section" wx:if="{{checkpointViews.length}}">
        <text class="section-title">检查点</text>
        <view wx:for="{{checkpointViews}}" wx:key="key" class="slot">
          <view class="slot-info">
            <text class="slot-label">{{item.label}}</text>
            <text class="slot-time">{{item.timeText}}</text>
          </view>
          <button class="btn" disabled="{{!item.valid}}" data-key="{{item.key}}" bindtap="onCheckpoint">继续</button>
        </view>
      </view>
    </scroll-view>
  </view>
</view>