<view class="card {{variant}}" bindtap="onTap" hover-class="card-hover">
  <image class="cover" src="{{card.cover}}" mode="aspectFill" />
  <view class="body">
    <view class="title">{{card.title}}</view>
    <view wx:if="{{variant === 'grid'}}" class="tagline">{{card.tagline}}</view>
    <view class="players">{{playersText}}人玩过</view>
    <view wx:if="{{progress >= 0}}" class="progress-wrap">
      <view class="progress-bar"><view class="progress-fill" style="width:{{progress * 100}}%"></view></view>
      <view class="progress-text">已解锁 {{endingsGot}}/{{card.endingCount}}个结局</view>
    </view>
  </view>
</view>
