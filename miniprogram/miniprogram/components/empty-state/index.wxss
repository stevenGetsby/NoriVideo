.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 32rpx;
}
.empty-text {
  color: var(--text-3);
  font-size: var(--font-body);
  text-align: center;
}
.empty-btn {
  margin-top: 32rpx;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-button);
  background: var(--surface-2);
  color: var(--text);
  font-size: var(--font-body);
}
.empty-btn-hover {
  opacity: 0.85;
}
