.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.title {
  color: var(--text);
  font-size: var(--font-title);
  font-weight: 600;
  text-align: center;
}
.btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-button);
  background: var(--surface-2);
  color: var(--text);
  font-size: var(--font-body);
  font-weight: 600;
}
.btn-primary {
  margin-top: 32rpx;
  background: var(--brand);
  color: #fff;
}
.btn::after {
  border: none;
}
.cancel {
  margin-top: 24rpx;
  text-align: center;
  color: var(--text-3);
  font-size: var(--font-body);
}
