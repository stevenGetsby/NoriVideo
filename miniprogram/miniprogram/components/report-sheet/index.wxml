<view wx:if="{{show}}" class="mask" bindtap="onClose">
  <view class="sheet" catchtap="noop">
    <view class="title">举报</view>
    <view class="reasons">
      <view
        wx:for="{{reasons}}"
        wx:key="value"
        class="reason {{reason === item.value ? 'reason-on' : ''}}"
        data-value="{{item.value}}"
        bindtap="onReason"
      >{{item.label}}</view>
    </view>
    <textarea
      class="detail"
      placeholder="补充说明（选填）"
      maxlength="200"
      value="{{detail}}"
      bindinput="onDetail"
    />
    <view class="submit {{reason && !submitting ? '' : 'submit-disabled'}}" bindtap="onSubmit">提交举报</view>
    <view class="cancel" bindtap="onClose">取消</view>
  </view>
</view>
