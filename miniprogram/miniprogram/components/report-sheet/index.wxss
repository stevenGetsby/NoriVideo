.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 24rpx 24rpx 0 0;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}
.title {
  color: var(--text);
  font-size: var(--font-title);
  font-weight: 600;
  text-align: center;
}
.reasons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 32rpx 0;
}
.reason {
  padding: 12rpx 24rpx;
  border-radius: var(--radius-tag);
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
  border: 2rpx solid transparent;
}
.reason-on {
  border-color: var(--brand);
  color: var(--text);
}
.detail {
  width: 100%;
  height: 160rpx;
  background: var(--surface-2);
  border-radius: var(--radius-tag);
  padding: 16rpx;
  box-sizing: border-box;
  color: var(--text);
  font-size: var(--font-body);
}
.submit {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--radius-button);
  background: var(--accent-gradient);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 600;
}
.submit-disabled {
  opacity: 0.4;
}
.cancel {
  margin-top: 24rpx;
  text-align: center;
  color: var(--text-3);
  font-size: var(--font-body);
}
