.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.card {
  width: 560rpx;
  background: var(--surface);
  border-radius: var(--radius-card);
  padding: 48rpx 40rpx;
}
.title {
  color: var(--text);
  font-size: var(--font-title);
  font-weight: 600;
  text-align: center;
}
.body {
  color: var(--text-2);
  font-size: var(--font-body);
  margin: 32rpx 0;
  line-height: 1.6;
}
.link {
  color: var(--brand);
}
.actions {
  display: flex;
  gap: 24rpx;
}
.btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-button);
  font-size: var(--font-body);
}
.btn-ghost {
  background: var(--surface-2);
  color: var(--text-2);
}
.btn-primary {
  background: var(--accent-gradient);
  color: #fff;
  font-weight: 600;
  padding: 0;
  margin: 0;
}
.btn-primary::after {
  border: none;
}
