.grid {
  display: grid;
  gap: 16rpx;
}
.cell {
  border: 2rpx solid var(--border);
  border-radius: var(--radius-tag);
  padding: 20rpx 8rpx;
  text-align: center;
  background: var(--surface);
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.cell-good {
  border-color: var(--ending-good);
}
.cell-normal {
  border-color: var(--ending-normal);
}
.cell-bad {
  border-color: var(--ending-bad);
}
.cell-hidden {
  border-color: var(--ending-hidden);
}
.label {
  color: var(--text);
  font-size: var(--font-aux);
}
.cell-locked .label {
  color: var(--text-3);
}
.lock {
  width: 24rpx;
  height: 20rpx;
  border: 2rpx solid var(--text-3);
  border-radius: 4rpx;
  position: relative;
  margin-bottom: 12rpx;
}
.lock::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 4rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid var(--text-3);
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
}
