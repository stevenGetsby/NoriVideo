.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx var(--page-padding) 48rpx;
}
.title {
  color: var(--text);
  font-size: var(--font-title);
  font-weight: 600;
  margin-bottom: 32rpx;
}
.para {
  color: var(--text-2);
  font-size: var(--font-body);
  line-height: 1.8;
  margin-bottom: 24rpx;
}
