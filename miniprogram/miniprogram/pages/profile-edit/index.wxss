.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 8rpx var(--page-padding) 48rpx;
}
.label {
  color: var(--text-2);
  font-size: var(--font-aux);
  margin: 32rpx 0 16rpx;
}
.avatars {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}
.avatar-cell {
  aspect-ratio: 1;
  border-radius: 50%;
  border: 4rpx solid transparent;
  padding: 4rpx;
  box-sizing: border-box;
}
.avatar-on {
  border-color: var(--brand);
}
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--surface-2);
  display: block;
}
.nickname {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-button);
  background: var(--surface);
  border: 2rpx solid var(--border);
  color: var(--text);
  font-size: var(--font-body);
}
.hint {
  color: var(--text-3);
  font-size: var(--font-aux);
  margin-top: 12rpx;
}
.save {
  margin: 48rpx 0 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-button);
  background: var(--accent-gradient);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 600;
}
.save::after {
  border: none;
}
.save[disabled] {
  opacity: 0.6;
  color: #fff;
}
.skeleton {
  padding-top: 32rpx;
}
.sk-grid {
  height: 320rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
.sk-line {
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-button);
  background: var(--surface-2);
}
