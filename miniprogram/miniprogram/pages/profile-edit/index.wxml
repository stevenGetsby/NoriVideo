<view class="page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-grid"></view><view class="sk-line"></view></view>
  <empty-state wx:elif="{{error}}" text="网络开小差了，点击重试" button="重试" bind:action="load" />
  <empty-state wx:elif="{{needLogin}}" text="登录后编辑资料" button="登录" bind:action="onLogin" />

  <block wx:else>
    <view class="label">选择头像</view>
    <view class="avatars">
      <view
        class="avatar-cell {{avatarIndex === item.index ? 'avatar-on' : ''}}"
        wx:for="{{avatars}}"
        wx:key="index"
        data-index="{{item.index}}"
        bindtap="onPickAvatar"
      >
        <image class="avatar-img" src="{{item.src}}" mode="aspectFill" />
      </view>
    </view>

    <view class="label">昵称</view>
    <input class="nickname" type="nickname" value="{{nickname}}" placeholder="输入昵称" maxlength="16" bindinput="onNicknameInput" />
    <view class="hint">2–16 字</view>

    <button class="save" bindtap="onSave" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
  </block>

  <privacy-popup />
</view>
