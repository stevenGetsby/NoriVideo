.page {
  min-height: 100vh;
  background: var(--bg);
}
.search-capsule {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--text-3);
  font-size: var(--font-aux);
}
.section {
  padding: 0 var(--page-padding) 48rpx;
}
.hero {
  width: 100%;
  height: 860rpx;
}
.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
}
.hero-img {
  width: 100%;
  height: 100%;
}
.hero-grad {
  position: absolute;
  inset: 0;
}
.hero-info {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 64rpx;
}
.hero-title {
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
}
.hero-sub {
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-body);
  margin-top: 8rpx;
}
.hero-btn {
  display: inline-block;
  margin-top: 24rpx;
  padding: 16rpx 48rpx;
  border-radius: var(--radius-button);
  background: var(--accent-gradient);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 600;
}
.hscroll {
  width: 100%;
  white-space: nowrap;
}
.hscroll-inner {
  display: flex;
  padding-bottom: 8rpx;
}
.hcard {
  width: 280rpx;
  flex-shrink: 0;
  margin-right: var(--grid-gap);
  display: inline-block;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
.pick-tile {
  background: var(--surface);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.pick-img {
  width: 100%;
  aspect-ratio: 3 / 4;
  display: block;
  background: var(--surface-2);
}
.pick-title {
  padding: 16rpx;
  color: var(--text);
  font-size: var(--font-card-title);
  font-weight: 600;
}
.upcoming {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}
.up-cover {
  width: 96rpx;
  height: 128rpx;
  border-radius: var(--radius-tag);
  background: var(--surface-2);
  flex-shrink: 0;
}
.up-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.up-title {
  color: var(--text);
  font-size: var(--font-card-title);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.up-date {
  color: var(--text-3);
  font-size: var(--font-aux);
  margin-top: 8rpx;
}
.up-btn {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-button);
  background: var(--surface-2);
  color: var(--text);
  font-size: var(--font-aux);
  flex-shrink: 0;
}
.up-btn-on {
  color: var(--text-3);
}
.topic {
  position: relative;
  border-radius: var(--radius-card);
  overflow: hidden;
  margin-bottom: var(--grid-gap);
}
.topic-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  display: block;
  background: var(--surface-2);
}
.topic-info {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
}
.topic-title {
  color: #fff;
  font-size: var(--font-title);
  font-weight: 600;
}
.topic-sub {
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-aux);
  margin-top: 6rpx;
}
.skeleton {
  padding: 24rpx var(--page-padding);
}
.sk-hero {
  width: 100%;
  height: 600rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
.sk-row {
  height: 120rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
.sk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
  margin-top: 24rpx;
}
.sk-card {
  height: 400rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
