.page {
  min-height: 100vh;
  background: var(--bg);
}
.header {
  display: flex;
  align-items: center;
  padding: 48rpx var(--page-padding);
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--surface-2);
  flex-shrink: 0;
}
.who {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}
.nickname {
  color: var(--text);
  font-size: var(--font-title);
  font-weight: 600;
}
.stats {
  color: var(--text-3);
  font-size: var(--font-aux);
  margin-top: 12rpx;
}
.edit {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
  flex-shrink: 0;
}
.list {
  margin: 0 var(--page-padding);
  background: var(--surface);
  border-radius: var(--radius-card);
  overflow: hidden;
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--border);
}
.item:last-child {
  border-bottom: none;
}
.label {
  color: var(--text);
  font-size: var(--font-body);
}
.arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid var(--text-3);
  border-right: 4rpx solid var(--text-3);
  transform: rotate(45deg);
}
.skeleton {
  padding: 48rpx var(--page-padding);
}
.sk-head {
  height: 128rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
.sk-line {
  height: 240rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
