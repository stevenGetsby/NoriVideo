<view class="page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-head"></view><view class="sk-line"></view></view>
  <empty-state wx:elif="{{error}}" text="网络开小差了，点击重试" button="重试" bind:action="load" />
  <empty-state wx:elif="{{needLogin}}" text="登录后查看你的游玩记录" button="登录" bind:action="onLogin" />

  <block wx:else>
    <view class="header">
      <image class="avatar" src="{{avatar}}" mode="aspectFill" />
      <view class="who">
        <view class="nickname">{{user.nickname}}</view>
        <view class="stats">玩过{{user.stats.played}}部 · 结局{{user.stats.endings}} · 成就{{user.stats.achievements}}</view>
      </view>
      <view class="edit" bindtap="goEdit">编辑资料</view>
    </view>

    <view class="list">
      <view class="item" bindtap="goHistory"><view class="label">游玩记录</view><view class="arrow"></view></view>
      <view class="item" bindtap="goFavorites"><view class="label">我的收藏</view><view class="arrow"></view></view>
      <view class="item" bindtap="goReservations"><view class="label">我的预约</view><view class="arrow"></view></view>
      <view class="item" bindtap="goSettings"><view class="label">设置</view><view class="arrow"></view></view>
    </view>
  </block>
</view>
