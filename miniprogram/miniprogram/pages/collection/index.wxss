.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 48rpx;
}
.section {
  margin: 32rpx var(--page-padding) 0;
}
.section-title {
  color: var(--text);
  font-size: var(--font-title);
  font-weight: 600;
  margin-bottom: 24rpx;
}
.skeleton {
  padding: 32rpx var(--page-padding);
}
.sk-block {
  height: 240rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
  margin-bottom: 24rpx;
}
