.page {
  min-height: 100vh;
  background: var(--bg);
}
.tabs {
  display: flex;
  gap: 48rpx;
  padding: 24rpx var(--page-padding);
}
.tab {
  color: var(--text-3);
  font-size: var(--font-title);
  font-weight: 600;
}
.tab-on {
  color: var(--text);
}
.segmented {
  display: flex;
  gap: 16rpx;
  padding: 8rpx var(--page-padding) 16rpx;
}
.seg {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--text-2);
  font-size: var(--font-aux);
}
.seg-on {
  background: var(--surface-2);
  color: var(--text);
}
.tagbar {
  width: 100%;
  white-space: nowrap;
}
.tagbar-inner {
  display: flex;
  padding: 8rpx var(--page-padding);
}
.tag {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--text-2);
  font-size: var(--font-aux);
  flex-shrink: 0;
}
.tag-on {
  background: var(--brand);
  color: #fff;
}
.body {
  padding: 0 var(--page-padding) 48rpx;
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
.more {
  text-align: center;
  color: var(--text-3);
  font-size: var(--font-aux);
  padding: 32rpx 0;
}
.sk-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.sk-row {
  height: 128rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
.sk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
.sk-card {
  height: 400rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
