.page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 160rpx;
}
.header {
  position: relative;
  width: 100%;
}
.trailer,
.cover {
  width: 100%;
  aspect-ratio: 3 / 4;
  display: block;
}
.mute {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: var(--font-aux);
}
.menu {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 40rpx;
}
.body {
  padding: 24rpx var(--page-padding) 48rpx;
}
.title {
  color: var(--text);
  font-size: 48rpx;
  font-weight: 600;
}
.creator {
  color: var(--text-2);
  font-size: var(--font-body);
  margin-top: 8rpx;
}
.tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}
.tag {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-tag);
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
}
.ai-badge {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-tag);
  background: var(--surface-2);
  color: var(--text-3);
  font-size: var(--font-aux);
}
.stats {
  color: var(--text-2);
  font-size: var(--font-aux);
  margin-top: 20rpx;
}
.rating {
  color: var(--ending-hidden);
  font-size: var(--font-body);
  margin-top: 8rpx;
}
.synopsis {
  color: var(--text-2);
  font-size: var(--font-body);
  line-height: 1.6;
  margin-top: 20rpx;
}
.synopsis-clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.synopsis-toggle {
  color: var(--brand);
  font-size: var(--font-aux);
  margin-top: 8rpx;
}
.chapter {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border);
}
.chapter-title {
  color: var(--text);
  font-size: var(--font-body);
}
.chapter-dur {
  color: var(--text-3);
  font-size: var(--font-aux);
}
.bottombar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx var(--page-padding) calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 2rpx solid var(--border);
}
.fav {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-button);
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
}
.fav-on {
  color: var(--ending-hidden);
}
.share {
  margin: 0;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-button);
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
  line-height: 1.4;
}
.share::after {
  border: none;
}
.restart {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-button);
  background: var(--surface-2);
  color: var(--text-2);
  font-size: var(--font-aux);
}
.main {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: var(--radius-button);
  background: var(--accent-gradient);
  color: #fff;
  font-size: var(--font-body);
  font-weight: 600;
}
.skeleton {
  padding: 0 var(--page-padding);
}
.sk-header {
  width: 100%;
  height: 600rpx;
  background: var(--surface-2);
}
.sk-line {
  height: 48rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-tag);
  background: var(--surface-2);
}
.sk-line.short {
  width: 50%;
}
.sk-block {
  height: 240rpx;
  margin-top: 24rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
