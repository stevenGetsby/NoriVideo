.page {
  min-height: 100vh;
  background: var(--bg);
}
.body {
  padding: 16rpx var(--page-padding) 48rpx;
}
.sk-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 24rpx var(--page-padding);
}
.sk-row {
  height: 128rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
