<view class="page">
  <view class="group">
    <view class="group-title">播放画质</view>
    <view
      class="opt {{quality === item.k ? 'opt-on' : ''}}"
      wx:for="{{qualityOptions}}"
      wx:key="k"
      data-k="{{item.k}}"
      bindtap="onQuality"
    >
      <view class="opt-label">{{item.label}}</view>
      <view wx:if="{{quality === item.k}}" class="check"></view>
    </view>
  </view>

  <view class="group">
    <view class="row">
      <view class="row-label">非 Wi-Fi 下自动播放预告</view>
      <switch checked="{{autoplayOnCellular}}" color="#4C7DFF" bindchange="onAutoplay" />
    </view>
  </view>

  <view class="group">
    <view class="row" bindtap="onClearCache">
      <view class="row-label">清除缓存</view>
      <view class="arrow"></view>
    </view>
  </view>

  <view class="group">
    <view class="row" data-k="terms" bindtap="goDoc"><view class="row-label">用户协议</view><view class="arrow"></view></view>
    <view class="row" data-k="privacy" bindtap="goDoc"><view class="row-label">隐私政策</view><view class="arrow"></view></view>
    <view class="row" data-k="about" bindtap="goDoc"><view class="row-label">关于{{brand}}</view><view class="arrow"></view></view>
  </view>
</view>
