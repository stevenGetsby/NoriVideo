.page {
  min-height: 100vh;
  background: var(--bg);
}
.searchbar {
  display: flex;
  align-items: center;
  padding: 16rpx var(--page-padding);
  gap: 16rpx;
}
.input {
  flex: 1;
  height: 72rpx;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 0 32rpx;
  color: var(--text);
  font-size: var(--font-body);
}
.ph {
  color: var(--text-3);
}
.clear {
  color: var(--text-3);
  font-size: var(--font-aux);
}
.body {
  padding: 16rpx var(--page-padding) 48rpx;
}
.hot-title {
  color: var(--text-2);
  font-size: var(--font-body);
  margin-bottom: 24rpx;
}
.hot-words {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.hot-word {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--text);
  font-size: var(--font-aux);
}
.grid2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
.sk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--grid-gap);
}
.sk-card {
  height: 400rpx;
  border-radius: var(--radius-card);
  background: var(--surface-2);
}
