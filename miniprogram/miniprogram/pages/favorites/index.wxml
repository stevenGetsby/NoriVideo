<view class="page">
  <view wx:if="{{loading}}" class="skeleton"><view class="sk-card"></view><view class="sk-card"></view><view class="sk-card"></view><view class="sk-card"></view></view>
  <empty-state wx:elif="{{error}}" text="网络开小差了，点击重试" button="重试" bind:action="onRetry" />
  <empty-state wx:elif="{{needLogin}}" text="登录后查看你的收藏" button="登录" bind:action="onLogin" />
  <empty-state wx:elif="{{items.length === 0}}" text="还没有收藏的作品" button="去首页看看" bind:action="goHome" />

  <block wx:else>
    <view class="grid">
      <work-card wx:for="{{items}}" wx:key="slug" card="{{item}}" variant="grid" bind:tap="onCardTap" />
    </view>
    <view wx:if="{{loadingMore}}" class="loading-more">加载中…</view>
  </block>
</view>
