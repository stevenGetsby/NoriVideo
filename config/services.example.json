{
  "storage": {
    "type": "tos",
    "tos": {
      "endpoint": "https://tos-cn-beijing.volces.com",
      "publicEndpoint": "https://tos-cn-beijing.volces.com",
      "region": "cn-beijing",
      "bucket": "nori-test",
      "accessKey": "your-tos-access-key",
      "secretKey": "your-tos-secret-key",
      "forcePathStyle": false
    }
