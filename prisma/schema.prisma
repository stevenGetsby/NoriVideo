  reasoning     Json?
  status        String   @default("draft")
  scenes        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, episodeNumber])
  @@index([projectId])
  @@index([scriptId])
  @@map("frameos_screenwriter_episodes")
