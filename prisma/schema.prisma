// =====================================================
// FrameOS — Production service
// =====================================================
model FrameosProductionScene {
  id         String   @id @default(uuid())
  projectId  String
  episodeId  String
  sceneNo    Int
  sceneTitle String
  createdAt  DateTime @default(now())

  @@unique([projectId, episodeId, sceneNo])
  @@index([projectId])
  @@index([episodeId])
  @@map("frameos_production_scenes")
}

model FrameosProductionShot {
  id                 String   @id @default(uuid())
  projectId          String
  episodeId          String
  sceneId            String
  shotNo             String
  shotTitle          String?
  shotStatus         String   @default("pending")
