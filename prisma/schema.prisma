  projectId          String
  title              String
  content            String   @db.LongText
  status             String   @default("draft") // available | draft | archived
  bibleContent       Json?
  bibleLocked        Boolean  @default(false)
  targetBibleContent Json?
  targetBibleLocked  Boolean  @default(false)
  marketRules        Json?
  sections           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
  @@index([projectId])
  @@map("frameos_scripts")
}

model FrameosWorld {
  id                  String   @id @default(uuid())
  projectId           String
  worldLabel          String
  worldBackground     String?  @db.Text
  representativeFrame String?
  candidates          Json?
  selectedStyleAnchor String?
  previewMaterials    Json?
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([projectId, worldLabel])
  @@index([projectId])
  @@map("frameos_worlds")
}

model FrameosArtDirection {
  id                String   @id @default(uuid())
  projectId         String   @unique
  flowStatus        String   @default("idle")
  flowId            String?
  currentLabel      String?
  derivedPhase      String?
  defaultWorldLabel String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("frameos_art_directions")
}

model FrameosScreenwriterEpisode {
  id            String   @id @default(uuid())
  projectId     String
  scriptId      String?
  episodeNumber Int
  title         String
  content       String   @db.LongText
  contentKilo   Float    @default(0)
  infoPoints    String?  @db.Text
