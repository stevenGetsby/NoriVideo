  projectId            String
  episodeId            String // FrameosScreenwriterEpisode.id
  directorConfirmed    Boolean  @default(false)
  shotStatus           String   @default("pending")
  steps                Json?
  emotionArc           String?  @db.Text
  reasoning            Json?
  bgmPlans             Json?
  totalSceneCount      Int      @default(0)
  totalShotCount       Int      @default(0)
  totalDurationSeconds Float    @default(0)
  scenes               Json?
  createdAt            DateTime @default(now())
