  errorMessage       String?                     @db.Text
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  screenwriterTask   ScreenwriterTask            @relation(fields: [screenwriterTaskId], references: [id], onDelete: Cascade)
  mediaObject        MediaObject?                @relation("ScreenwriterSourceVideoMedia", fields: [mediaObjectId], references: [id], onDelete: SetNull)
  scriptEpisodes     ScreenwriterScriptEpisode[]

  @@unique([screenwriterTaskId, episodeNumber])
  @@index([screenwriterTaskId])
  @@index([mediaObjectId])
  @@map("screenwriter_source_videos")
}

