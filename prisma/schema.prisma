  @@index([sceneId])
  @@map("frameos_production_shots")
}

model FrameosProductionBgmTask {
  id               String   @id @default(uuid())
  projectId        String
  sceneId          String
  taskId           String?
  status           String   @default("idle")
  url              String?  @db.Text
  errorMessage     String?  @db.Text
  caption          String?  @db.Text
  lyrics           String?  @db.Text
  durationEstimate Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([projectId, sceneId])
  @@index([projectId])
  @@map("frameos_production_bgm_tasks")
}

// =====================================================
// FrameOS — Toolbox service
